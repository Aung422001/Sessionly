          "content": "INSPIRATION, DISSECTED",
          "fontFamily": "Inter",
          "fontSize": 11,
          "fontWeight": "700",
          "letterSpacing": 1.6
        },
        {
          "type": "text",
          "id": "Z8yu6z",
          "x": 64,
          "y": 285,
          "name": "Principle 1",
          "fill": "#123F3B",
          "content": "01 / Travel journals",
          "fontFamily": "Newsreader",
          "fontSize": 21,
          "fontWeight": "normal"
        },
        {
          "type": "text",
          "id": "wwpzd",
          "x": 64,
          "y": 322,
          "name": "Explanation 1",
          "fill": "#53635D",
          "textGrowth": "fixed-width",
          "width": 390,
          "content": "A destination is first felt through atmosphere. Lead with a wide, specific landscape and give its location a useful caption.",
          "lineHeight": 1.5,
          "fontFamily": "Inter",
          "fontSize": 14,
          "fontWeight": "normal"
        },
        {
          "type": "text",
          "id": "xbm9N",
          "x": 509,
          "y": 285,
          "name": "Principle 2",
          "fill": "#123F3B",
          "content": "02 / Printed field guides",
          "fontFamily": "Newsreader",
          "fontSize": 21,
          "fontWeight": "normal"
        },
        {
          "type": "text",
          "id": "rpy5n",
          "x": 509,
          "y": 322,
          "name": "Explanation 2",
          "fill": "#53635D",
          "textGrowth": "fixed-width",
          "width": 390,
          "content": "A numbered city index and fine rules give browsing rhythm without boxing every item into a card.",
          "lineHeight": 1.5,
          "fontFamily": "Inter",
          "fontSize": 14,
          "fontWeight": "normal"
        },
        {
          "type": "text",
          "id": "D2qL9",
          "x": 954,
          "y": 285,
          "name": "Principle 3",
          "fill": "#123F3B",
          "content": "03 / Honest itineraries",
          "fontFamily": "Newsreader",
          "fontSize": 21,
          "fontWeight": "normal"
        },
        {
          "type": "text",
          "id": "xOsiu",
          "x": 954,
          "y": 322,
          "name": "Explanation 3",
          "fill": "#53635D",
          "textGrowth": "fixed-width",
          "width": 390,
          "content": "Prices read like a trip ledger: nightly rate, full-stay total and demo fee remain legible together.",
          "lineHeight": 1.5,
          "fontFamily": "Inter",
          "fontSize": 14,
          "fontWeight": "normal"
        },
        {
          "type": "frame",
